{
  "name": "passguard-monorepo",
  "version": "1.1.1",
  "private": true,
  "workspaces": [
    "client",
    "examples/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "test": "npm run test --workspace=client",
    "test:watch": "npm run test:watch --workspace=client",
    "test:coverage": "npm run test:coverage --workspace=client",
    "test:e2e": "npm run test:e2e --workspace=client",
    "lint": "npm run lint --workspace=client",
    "typecheck": "npm run lint --workspace=client",
    "package": "npm run pack:dry --workspace=client"
  }
}